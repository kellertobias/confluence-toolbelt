{
  "repositoryUrl": "https://github.com/kellertobias/confluence-toolbelt.git",
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm run build && node version-bump.mjs ${nextRelease.version} && npm run build:plugin"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "assets": [
          { "path": "plugin-dist/main.js", "name": "main.js", "label": "main.js" },
          { "path": "manifest.json", "name": "manifest.json", "label": "manifest.json" },
          { "path": "styles.css", "name": "styles.css", "label": "styles.css" },
          { "path": "versions.json", "name": "versions.json", "label": "versions.json" }
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "package-lock.json",
          "manifest.json",
          "versions.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
